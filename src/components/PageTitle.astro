---
const route = Astro.locals.starlightRoute;
const isHome = route.entry.data.title === 'Home';

type TrailItem = { label: string; href?: string };
type NavEntry = { type: 'link'; label: string; href: string; isCurrent?: boolean } | { type: 'group'; label: string; entries: NavEntry[] };

function descendantHrefs(entries: NavEntry[]): string[] {
  return entries.flatMap((entry) => entry.type === 'link' ? [entry.href] : descendantHrefs(entry.entries));
}

function groupHref(entries: NavEntry[]): string | undefined {
  const hrefs = descendantHrefs(entries);
  if (hrefs.length === 0) return;

  const segmentLists = hrefs.map((href) => href.split('/').filter(Boolean));
  const commonSegments: string[] = [];
  for (const [index, segment] of (segmentLists[0] || []).entries()) {
    if (!segmentLists.every((segments) => segments[index] === segment)) break;
    commonSegments.push(segment);
  }

  return commonSegments.length > 0 ? `/${commonSegments.join('/')}/` : undefined;
}

function findTrail(entries: NavEntry[], trail: TrailItem[] = []): TrailItem[] | undefined {
  for (const entry of entries) {
    if (entry.type === 'link' && entry.isCurrent) return [...trail, { label: entry.label, href: entry.href }];
    if (entry.type === 'group') {
      const nested = findTrail(entry.entries, [...trail, { label: entry.label, href: groupHref(entry.entries) }]);
      if (nested) return nested;
    }
  }
}

const trail = isHome ? [] : (findTrail(route.sidebar as NavEntry[]) || []);
---

{!isHome && (
  <div class="ft-page-heading">
    {trail.length > 1 && (
      <nav class="ft-breadcrumbs" aria-label="Breadcrumb">
        {trail.map((item, index) => (
          <>
            {index > 0 && <span class="separator" aria-hidden="true">›</span>}
            {item.href && index < trail.length - 1 ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
          </>
        ))}
      </nav>
    )}
    <h1 id="_top">{route.entry.data.title}</h1>
  </div>
)}

<style>
  @layer starlight.core {
    .ft-breadcrumbs { display: flex; align-items: center; flex-wrap: wrap; gap: .45rem; color: var(--sl-color-gray-3); font-size: .8125rem; line-height: 1.45; font-weight: 550; margin-bottom: 1rem; }
    .ft-breadcrumbs a { color: var(--sl-color-gray-2); text-decoration: none; }
    .ft-breadcrumbs a:hover { color: var(--ft-blue); }
    .ft-breadcrumbs .separator { color: var(--sl-color-gray-4); font-size: 1rem; }
    h1 { margin: 0; max-width: 48rem; font-size: clamp(2rem, 3vw, 2.5rem); line-height: 1.12; letter-spacing: -.038em; font-weight: 750; color: var(--sl-color-white); }
  }
</style>
