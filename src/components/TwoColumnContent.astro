---
const { toc } = Astro.locals.starlightRoute;
const isHome = Astro.locals.starlightRoute.entry.data.title === 'Home';
const authoredTocItems = toc?.items.filter((item) => item.slug !== '_top') || [];
const hasMeaningfulToc = !isHome && authoredTocItems.length >= 3;
---

<div class:list={['ft-doc-shell', 'lg:sl-flex', hasMeaningfulToc ? 'ft-has-toc' : 'ft-single-column']}>
  {hasMeaningfulToc && (
    <aside class="right-sidebar-container print:hidden">
      <div class="right-sidebar">
        <slot name="right-sidebar" />
      </div>
    </aside>
  )}
  <div class="main-pane"><slot /></div>
</div>

<style>
  @layer starlight.core {
    .main-pane { isolation: isolate; }

    @media (min-width: 72rem) {
      .right-sidebar-container {
        order: 2;
        position: relative;
        flex: 0 0 15.5rem;
        width: 15.5rem;
      }

      .right-sidebar {
        position: fixed;
        top: 0;
        border-inline-start: 1px solid var(--sl-color-hairline);
        padding-top: var(--sl-nav-height);
        width: 100%;
        height: 100vh;
        overflow-y: auto;
        scrollbar-width: none;
      }

      .main-pane {
        --sl-content-margin-inline: 3rem auto;
        order: 1;
        width: 100%;
      }

      .ft-has-toc .main-pane {
        width: calc(100% - 15.5rem);
      }
    }
  }
</style>
