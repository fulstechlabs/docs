---
const { toc } = Astro.locals.starlightRoute;
const hasMeaningfulToc = Boolean(toc?.items.some((item) => item.slug !== '_top'));
---

<div class:list={['lg:sl-flex', hasMeaningfulToc ? 'ft-has-toc' : 'ft-single-column']}>
  {hasMeaningfulToc && (
    <aside class="right-sidebar-container print:hidden">
      <div class="right-sidebar">
        <slot name="right-sidebar" />
      </div>
    </aside>
  )}
  <div class="main-pane"><slot /></div>
</div>

<style>
  @layer starlight.core {
    .main-pane { isolation: isolate; }

    @media (min-width: 72rem) {
      .right-sidebar-container {
        order: 2;
        position: relative;
        width: max(
          var(--sl-sidebar-width),
          calc(var(--sl-sidebar-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2)
        );
      }

      .right-sidebar {
        position: fixed;
        top: 0;
        border-inline-start: 1px solid var(--sl-color-hairline);
        padding-top: var(--sl-nav-height);
        width: 100%;
        height: 100vh;
        overflow-y: auto;
        scrollbar-width: none;
      }

      .main-pane { width: 100%; }

      :global([data-has-sidebar][data-has-toc]) .ft-has-toc .main-pane {
        --sl-content-margin-inline: auto 0;
        order: 1;
        width: min(
          calc(100% - var(--sl-sidebar-width)),
          calc(var(--sl-content-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2)
        );
      }
    }
  }
</style>
